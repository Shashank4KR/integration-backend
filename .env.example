# Database Connection (Async SQLAlchemy with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edtech_db

# JWT & Authentication
SECRET_KEY=change-me-to-a-secure-random-64-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Legacy database URL placeholder for local development
SUPABASE_DATABASE_URL=postgresql://user:password@localhost:5432/edtech_db
