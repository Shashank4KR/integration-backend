# Database Connection (Async SQLAlchemy with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edtech_db

# JWT & Authentication
SECRET_KEY=change-me-to-a-secure-random-64-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_MFA=false

# Optional local demonstration account. Keep disabled outside local development.
ENVIRONMENT=development
ENABLE_DEMO_SUPERADMIN=false
DEMO_SUPERADMIN_EMAIL=
DEMO_SUPERADMIN_PASSWORD=

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password reset email delivery
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=false

# Legacy database URL placeholder for local development
SUPABASE_DATABASE_URL=postgresql://user:password@localhost:5432/edtech_db
